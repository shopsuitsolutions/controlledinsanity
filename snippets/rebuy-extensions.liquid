                    v-on:click="hide()"
                    type="button">
                        <span v-html="continueLabel()"></span>
                </button>
            </div>

            <div class="powered-by-rebuy">
                <a v-bind:href="'https://rebuyengine.com/?shop=' + config.shop.myshopify_domain" target="_blank" rel="noopener">
                    Powered by Rebuy
                </a>
            </div>

        </div>

    </div>
  </div>
</script>

<!-- variant modal -->
<script id="rebuy-modal-variant-template" type="text/template">
    <div class="rebuy-modal" v-cloak v-bind:class="[visible ? 'is-visible' : 'is-hidden']" v-on:click="customCloseVariantModal()">
        <div class="rebuy-modal__container" v-cloak v-bind:class="[style, visible ? 'is-visible' : 'is-hidden']" v-on:click="stopPropagation($event)">

            <button class="rebuy-modal-close" v-on:click="window.customCloseVariantModal()" aria-label="close modal"
                type="button"
            >
                Close
            </button>

            <!-- CUSTOM - Title and price in header for desktop screens -->
            <div class="rebuy-modal__container-header">
                <h4 class="rebuy-modal__product-title" v-html="product.title"></h4>

                <div class="rebuy-modal__product-price">
                    <div v-if="variantOnSale(product, product.selected_variant)">
                        <span class="rebuy-money compare-at" v-html="formatMoney(variantCompareAtPrice(product, product.selected_variant))"></span>
                        <span class="rebuy-money sale" v-html="formatMoney(variantPrice(product, product.selected_variant))"></span>
                    </div>
                    <div v-if="!(variantOnSale(product, product.selected_variant))">
                        <span class="rebuy-money" v-html="formatMoney(variantPrice(product, product.selected_variant))"></span>
                    </div>
                </div>
            </div>
        <div class="rebuy-modal__container-body">

            <div class="rebuy-modal__product" v-bind:class="getModalLayoutClasses(settings.layout)">

                <div class="rebuy-modal__product-media" >

                    <div v-if="product.images.length > 1" class="rebuy-carousel">
                        <button class="carousel-button prev" v-on:click="window.prevImageModal()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="rebuy-icon"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <div class="carousel-images modal-carousel">
                            <div v-for="(image, image_index) in window?.filterModalImages(product)" v-bind:key="product.selected_variant_id" class="carousel-item" v-bind:class="{'is-active primary-image': image_index === 0, 'hover-img': image_index === 1}">
                                <div
                                        class="rebuy-product-image"
                                        tabindex="-1"
                                    >
                                    <img v-bind:src="image.src" v-bind:alt="image?.alt" v-bind:key="image.src"/>
                                </div>
                            </div>
                        </div>

                        <button class="carousel-button next" v-on:click="window.nextImageModal()">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="rebuy-icon"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>

                    <img v-else
                        class="rebuy-modal__product-media-image"
                        v-bind:src="itemImage(product, product.selected_variant, '800x800')"
                        v-bind:alt="product.title"
                    />

                    <div v-if="shouldShowSubImages()" class="rebuy-modal__product-sub-images">
                        <div
                            v-for="(image, index) in product.images.slice(0, 4)"
                            :key="image.id + '-sub-image-' + index"
                            class="rebuy-modal__product-sub-image"
                            v-on:click="handleSelectingImage(image)"
                            v-bind:class="{ 'is-active': getSelectedImage()?.id === image.id }"
                            role="button"
                            tabindex="0">
                            <img
                                v-bind:src="sizeImage(image.src, '200x200')"
                                v-bind:alt="product.title"
                            />
                        </div>
                    </div>

                </div> 

                <div class="rebuy-modal__product-info">
                
                    <h4 class="rebuy-modal__product-title" v-html="product.title"></h4>

                    <div class="rebuy-modal__product-price">
                        <div v-if="variantOnSale(product, product.selected_variant)">
                            <span class="rebuy-money compare-at" v-html="formatMoney(variantCompareAtPrice(product, product.selected_variant))"></span>
                            <span class="rebuy-money sale" v-html="formatMoney(variantPrice(product, product.selected_variant))"></span>
                        </div>
                        <div v-if="!(variantOnSale(product, product.selected_variant))">
                            <span class="rebuy-money" v-html="formatMoney(variantPrice(product, product.selected_variant))"></span>
                        </div>
                    </div>

                    <div class="rebuy-modal__product-options" v-if="product?.variants.length > 1">
                        
                        <div
                            v-if="isVariantSelectorButtons() && option.name !== 'Color'"
                            class="rebuy-modal__product-option rebuy-product-option"
                            v-for="option in product.options"
                        >
                                <div class="rebuy-product-option-name">
                                    <span class="rebuy-option-name" v-html="option.name + ': '"></span>
                                    <span
                                    class="rebuy-option-value"
                                    v-html="product['option' + option.position ]"
                                    ></span>
                                </div>

                                <div
                                    class="rebuy-modal__product-option-buttons rebuy-color-swatches"
                                    v-if="option.name == 'Color'"
                                >
                                    <!-- Color Swatches -->
                                    <span
                                    class="rebuy-modal-swatch rebuy-color-label"
                                    v-for="(value, index) in option.values"
                                    v-bind:class="{ 'active': product.selected_variant['option' + option.position] == value, 
                                      'unavailable': !variantOptionAvailable(product, 'option' + option.position, value) 
                                    }"
                                    v-on:click="selectVariantOption(product, 'option' + option.position, value)"
                                    :style="{ background: window?.theme?.colors?.[value] || value }">
                                    
                                    </span>
                                </div>

                                <!-- Size Swatches -->
                                <div class="rebuy-modal__product-option-buttons rebuy-size-swatches" v-else>
                                    <span
                                    class="rebuy-modal-swatch rebuy-size-label"
                                    v-for="(value, index) in option.values"
                                    v-bind:class="{ 'active': product.selected_variant['option' + option.position] == value, 
                                                'unavailable': !variantOptionAvailable(product, 'option' + option.position, value) }"
                                    v-on:click="selectVariantOption(product, 'option' + option.position, value)"
                                    >
                                    {{ value }}
                                    </span>
                                </div>
                            </div>

                            <div v-if="!isVariantSelectorButtons() && shouldShowVariantSelector()" class="rebuy-modal__product-option-select">
                                <select
                                    class="rebuy-select"
                                    v-bind:aria-label="'variant of ' + product.title"
                                    v-model="product.selected_variant_id"
                                    v-on:change="selectVariant(product)"
                                >
                                    <option v-for="variant in product.variants" v-bind:value="variant.id">{{ variant.title }}</option>
                                </select>
                            </div>
                    </div>

                    <div class="rebuy-modal__container-actions" v-bind:class="[buttons.length > 1 ? 'multi-button' : 'single-button']">
                        <button class="rebuy-button"
                            v-for="button in buttons"
                            v-bind:class="[button.type]"
                            v-bind:disabled="!(variantAvailable(product.selected_variant))"
                            v-on:click="button.callback"
                            v-html="button.label"
                            type="button"
                        >
                        </button>
                    </div>

                    <div class="rebuy-product-link" v-if="settings?.product_link">
                        <a
                            v-bind:href="settings.product_link"
                            class="rebuy-product-page-link"
                            v-html="'More details'"
                            v-bind:aria-label="'View ' + product.title"
                            rel="nofollow"
                        ></a>
                    </div>  

            </div>

        </div>

    </div>
  </div>
</script>
{% endraw %}