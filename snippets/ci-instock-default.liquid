{%- if settings.instock_default_collections and template.name == 'collection' -%}
  <script>
    (function () {
      try {
        if (sessionStorage.getItem('ci-instock-off')) return;
        if (location.search.indexOf('filter.') !== -1) return;
        var params = new URLSearchParams(location.search);
        params.set('filter.v.availability', '1');
        location.replace(location.pathname + '?' + params.toString());
      } catch (e) {}
    })();
    document.addEventListener('click', function (e) {
      var toggle = e.target.closest && e.target.closest('.ci-instock-toggle');
      if (toggle) {
        try {
          if (toggle.classList.contains('is-active')) sessionStorage.setItem('ci-instock-off', '1');
          else sessionStorage.removeItem('ci-instock-off');
        } catch (err) {}
      }
    }, true);
    document.addEventListener('change', function (e) {
      var input = e.target;
      if (input && input.name === 'filter.v.availability') {
        try {
          if (input.checked) sessionStorage.removeItem('ci-instock-off');
          else sessionStorage.setItem('ci-instock-off', '1');
        } catch (err) {}
      }
    }, true);
  </script>
{%- endif -%}
