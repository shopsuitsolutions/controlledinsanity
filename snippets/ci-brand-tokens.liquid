{% style %}
  :root {
    --ci-navbar-link-weight: {{ settings.navbar_link_weight | default: 600 }};
    --ci-quick-add-icon-color: {{ settings.quick_add_icon_color | default: '#000000' }};

    --ci-black: #000000;
    --ci-white: #ffffff;
    --ci-eggshell: #f1f0ec;
    --ci-maroon: #5c181f;
    --ci-sale-red: #e11d29;
    --ci-neutral-400: #b3b3b3;
    --ci-text-subdued-dark: #333333;
    --ci-text-subdued-medium: #b3b3b3;
    --ci-text-subdued-light: #e8e8e8;
    --ci-border-light: #efeded;

    --ci-space-2: 0.125rem;
    --ci-space-4: 0.25rem;
    --ci-space-6: 0.375rem;
    --ci-space-8: 0.5rem;
    --ci-space-10: 0.625rem;
    --ci-space-12: 0.75rem;
    --ci-space-14: 0.875rem;
    --ci-space-16: 1rem;
    --ci-space-20: 1.25rem;
    --ci-space-24: 1.5rem;
    --ci-space-32: 2rem;
    --ci-space-36: 2.25rem;
    --ci-space-40: 2.5rem;
    --ci-space-44: 2.75rem;
    --ci-space-64: 4rem;
    --ci-space-80: 5rem;
    --ci-space-112: 7rem;

    --ci-tracking-wide: 0.16em;
  }
{% endstyle %}

{%- if settings.logo_scrolled != blank -%}
  {% style %}
    #header-component[data-sticky-state="active"] .header-logo__image-container {
      display: none;
    }
    #header-component[data-sticky-state="active"] .header-logo::after {
      content: "";
      display: block;
      height: {{ settings.logo_height | default: 40 }}px;
      aspect-ratio: {{ settings.logo_scrolled.aspect_ratio | default: 1 }};
      background-color: currentColor;
      -webkit-mask: center / contain no-repeat url("{{ settings.logo_scrolled | image_url: width: 240 }}");
      mask: center / contain no-repeat url("{{ settings.logo_scrolled | image_url: width: 240 }}");
    }
    @media screen and (max-width: 749px) {
      #header-component[data-sticky-state="active"] .header-logo::after {
        height: {{ settings.logo_height_mobile | default: 28 }}px;
      }
    }
  {% endstyle %}
{%- endif -%}
