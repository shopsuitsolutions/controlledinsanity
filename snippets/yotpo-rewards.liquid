<script>
  window.yotpoDateFormatter = function(dateStr) {
  const date = new Date(dateStr);
  if (isNaN(date)) {
    if (dateStr === "Never") {
      return "Never";
    }
    return dateStr;
  }
  const month = date.getMonth() + 1;
  const day = date.getDate();
  const year = date.getFullYear();
  return `${month}/${day}/${year}`;
  };
</script>

<style>
.shopify-block:has(.yotpo-widget-loyalty-page),
.shopify-block:has(.yotpo-widget-referral-share)  {
    width: 100%;
}

.section:has(.yotpo-widget-loyalty-page),
.section:has(.yotpo-widget-referral-share)  {
    display: block;
}
</style>