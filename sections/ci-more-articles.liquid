{%- liquid
  assign max_articles = section.settings.max_articles | default: 6
  assign shown = 0
-%}
{%- if blog.articles.size > 1 -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="ci-more-articles section section--page-width color-{{ section.settings.color_scheme }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %} --ci-more-articles-gap: {{ section.settings.card_gap | default: 8 }}px;"
    {{ section.shopify_attributes }}
  >
    <ci-slider class="ci-more-articles__slider">
      <div class="ci-more-articles__header">
        <h3 class="ci-more-articles__heading">{{ section.settings.heading }}</h3>
        <div class="ci-more-articles__controls">
          <div class="ci-more-articles__nav">
            <button type="button" class="ci-more-articles__arrow" data-dir="prev" aria-label="{{ 'accessibility.previous' | t }}">
              <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true"><path d="M13 4L7.14427 9.67692C7.09873 9.71836 7.06243 9.76841 7.03761 9.82397C7.0128 9.87954 7 9.93945 7 10C7 10.0606 7.0128 10.1205 7.03761 10.176C7.06243 10.2316 7.09873 10.2816 7.14427 10.3231L13 16" stroke="currentColor" stroke-width="1.1" stroke-linecap="square"/></svg>
            </button>
            <button type="button" class="ci-more-articles__arrow" data-dir="next" aria-label="{{ 'accessibility.next' | t }}">
              <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true"><path d="M7 16L12.8557 10.3231C12.9013 10.2816 12.9376 10.2316 12.9624 10.176C12.9872 10.1205 13 10.0606 13 10C13 9.93945 12.9872 9.87954 12.9624 9.82397C12.9376 9.76841 12.9013 9.71836 12.8557 9.67692L7 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="square"/></svg>
            </button>
          </div>
          <a class="ci-more-articles__link" href="{{ blog.url }}">{{ section.settings.view_all_label }}</a>
        </div>
      </div>

      <div class="ci-more-articles__row" data-slider-row>
        {%- for a in blog.articles -%}
          {%- if a.id == article.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= max_articles -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <article class="ci-blog__card ci-more-articles__card">
            <a href="{{ a.url }}" class="ci-blog__media">
              {% if a.image %}
                {{ a.image | image_url: width: 800 | image_tag: class: 'ci-blog__img', loading: 'lazy', widths: '400, 600, 800', sizes: '(max-width: 749px) 85vw, 33vw', alt: a.title }}
              {% else %}
                <span class="ci-blog__img ci-blog__img--empty"></span>
              {% endif %}
            </a>
            <div class="ci-blog__body">
              <p class="ci-blog__date">{{ a.published_at | date: '%d/%m/%y' }}</p>
              <a href="{{ a.url }}" class="ci-blog__title-link">
                <h3 class="ci-blog__title">{{ a.title }}</h3>
              </a>
              <p class="ci-blog__excerpt">
                {%- if a.excerpt != blank -%}
                  {{ a.excerpt | strip_html | truncatewords: 22 }}
                {%- else -%}
                  {{ a.content | strip_html | truncatewords: 22 }}
                {%- endif -%}
              </p>
              <a href="{{ a.url }}" class="ci-blog__more">{{ section.settings.read_more_label | default: 'Read more' }}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="ci-more-articles__progress" data-slider-progress hidden>
        <span class="ci-more-articles__progress-thumb" data-slider-thumb></span>
      </div>
    </ci-slider>
  </div>
{%- endif -%}

{% stylesheet %}
  .ci-more-articles__slider {
    display: block;
    min-width: 0;
  }

  .ci-more-articles__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-block-end: 24px;
    width: 0;
    min-width: 100%;
  }

  .ci-more-articles__heading {
    margin: 0;
    font-size: 32px;
    line-height: 36px;
    letter-spacing: -0.32px;
  }

  .ci-more-articles__controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ci-more-articles__nav {
    display: flex;
    gap: 6px;
  }

  .ci-more-articles__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .ci-more-articles__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .ci-more-articles__link {
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
    color: var(--color-foreground);
  }

  .ci-more-articles__row {
    display: flex;
    gap: var(--ci-more-articles-gap, 8px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    width: 0;
    min-width: 100%;
  }

  .ci-more-articles__row::-webkit-scrollbar {
    display: none;
  }

  .ci-more-articles__card {
    flex: 0 0 calc((100% - var(--ci-more-articles-gap, 8px) * 2) / 3);
    scroll-snap-align: start;
  }

  .ci-more-articles .ci-blog__media {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .ci-more-articles .ci-blog__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ci-more-articles .ci-blog__img--empty {
    display: block;
  }

  .ci-more-articles .ci-blog__body {
    padding-block-start: 12px;
  }

  .ci-more-articles .ci-blog__date {
    margin: 0 0 6px;
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .ci-more-articles .ci-blog__title-link {
    text-decoration: none;
    color: inherit;
  }

  .ci-more-articles .ci-blog__title {
    margin: 0 0 8px;
    text-transform: uppercase;
    font-size: 1.25rem;
  }

  .ci-more-articles .ci-blog__excerpt {
    margin: 0 0 12px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .ci-more-articles .ci-blog__more {
    font-size: 0.75rem;
    font-weight: var(--font-subheading--weight, 600);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ci-more-articles__progress {
    position: relative;
    height: 2px;
    background-color: #f1f0ec;
    margin-top: 40px;
  }

  .ci-more-articles__progress[hidden] {
    display: none;
  }

  .ci-more-articles__progress-thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 20%;
    background-color: #000000;
    transition: left 0.12s linear;
  }

  @media screen and (min-width: 750px) {
    .ci-more-articles__progress {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ci-more-articles__nav {
      display: none;
    }

    .ci-more-articles .ci-more-articles__heading {
      font-size: 22px;
      line-height: 26px;
      letter-spacing: -0.22px;
    }

    .ci-more-articles__row {
      margin-inline: calc(var(--page-margin, 16px) * -1);
      padding-inline: var(--page-margin, 16px);
      min-width: calc(100% + var(--page-margin, 16px) * 2);
      scroll-padding-inline-start: var(--page-margin, 16px);
    }

    .ci-more-articles__card {
      flex: 0 0 85%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CI More articles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "More articles" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "text", "id": "read_more_label", "label": "Read more label", "default": "Read more" },
    { "type": "range", "id": "max_articles", "label": "Maximum articles", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "card_gap", "label": "Gap between cards", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 8 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "enabled_on": { "templates": ["article"] },
  "presets": [ { "name": "CI More articles" } ]
}
{% endschema %}
