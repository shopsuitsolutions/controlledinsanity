{% liquid
  assign s = section.settings
  assign desktop_image = s.image
  assign mobile_image = s.image_mobile | default: s.image
  assign ratio = 1.7778
  if desktop_image != blank
    assign ratio = desktop_image.aspect_ratio
  endif
  assign gated = true
  if s.mode == 'open'
    assign gated = false
  endif
  assign form_id = 'DropSignupForm-' | append: section.id
  assign text_scale = s.text_scale | divided_by: 100.0
  assign mobile_text_scale = s.mobile_text_scale | divided_by: 100.0
  assign mobile_panel_padding = s.mobile_panel_padding | divided_by: 100.0
  assign overlay_opacity = s.overlay_opacity | divided_by: 100.0
%}

{% if s.hide_chrome %}
  {% style %}
    #header-group,
    body > footer {
      display: none;
    }
  {% endstyle %}
{% endif %}

<div
  id="DropSignup-{{ section.id }}"
  class="drop-signup color-{{ s.color_scheme }} drop-signup--panel-{{ s.panel_side }} drop-signup--{{ s.mode }} drop-signup--align-{{ s.text_align }}{% if s.desktop_fade %} drop-signup--fade{% endif %}"
  style="
    --ds-ratio: {{ ratio }};
    --ds-panel-offset: {{ s.panel_offset }}%;
    --ds-panel-valign: {{ s.panel_valign }};
    --ds-mobile-focus: {{ s.mobile_focus }}%;
    --ds-mobile-img-height: {{ s.mobile_image_height }}svh;
    --ds-mobile-pad: {{ mobile_panel_padding }};
    --ds-chrome-offset: {% if s.hide_chrome %}0px{% else %}var(--header-group-height, 0px){% endif %};
    --ds-overlay: {{ overlay_opacity }};
    --ds-scale: {{ text_scale }};
    --ds-mobile-scale: {{ mobile_text_scale }};
  "
  {{ section.shopify_attributes }}
>
  <div class="drop-signup__hero">
    {% if desktop_image != blank %}
      <picture class="drop-signup__picture">
        {% if s.image_mobile != blank %}
          <source
            media="(max-width: 1023px)"
            srcset="{{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1024 }} 1024w, {{ mobile_image | image_url: width: 1536 }} 1536w"
            sizes="100vw"
          >
        {% endif %}
        {{
          desktop_image
          | image_url: width: 2000
          | image_tag:
            class: 'drop-signup__img',
            widths: '480, 750, 1024, 1280, 1440, 1920, 2000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: desktop_image.alt
        }}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'drop-signup__img drop-signup__img--placeholder' }}
    {% endif %}

    <div class="drop-signup__panel">
      {% form 'customer', class: 'drop-signup__form', id: form_id %}
        {% liquid
          assign posted = form.posted_successfully?
          assign show_discord = false
          if posted or gated == false
            assign show_discord = true
          endif
        %}

        {% if section.blocks.size == 0 and request.design_mode %}
          <p class="drop-signup__error">Add blocks to this section: Headline, Supporting copy, Email form, Confirmation, Divider, Discord button.</p>
        {% endif %}

        {% for block in section.blocks %}
          {% liquid
            assign b = block.settings
            assign b_space = b.space_above | default: 100 | divided_by: 100.0
            assign b_scale = b.size | default: 100 | divided_by: 100.0
          %}

          {% case block.type %}
            {% when 'heading' %}
              {% if b.text != blank %}
                {% liquid
                  assign h_case = 'none'
                  if b.uppercase
                    assign h_case = 'uppercase'
                  endif
                  assign h_leading = b.line_height | divided_by: 100.0
                  assign h_tracking = b.letter_spacing | times: 0.01
                %}
                <h1
                  class="drop-signup__block drop-signup__headline"
                  style="--b-space: {{ b_space }}; --b-scale: {{ b_scale }}; --b-leading: {{ h_leading }}; --b-tracking: {{ h_tracking }}em; --b-case: {{ h_case }};"
                  {{ block.shopify_attributes }}
                >{{ b.text | escape | newline_to_br }}</h1>
              {% endif %}

            {% when 'text' %}
              {% if b.text != blank %}
                <p
                  class="drop-signup__block drop-signup__lede"
                  style="--b-space: {{ b_space }}; --b-scale: {{ b_scale }}; --b-max: {{ b.max_width }}ch;"
                  {{ block.shopify_attributes }}
                >{{ b.text | escape | newline_to_br }}</p>
              {% endif %}

            {% when 'email_form' %}
              {% unless posted %}
                {% liquid
                  case b.button_size
                    when 'small'
                      assign submit_pad = 0.8
                    when 'large'
                      assign submit_pad = 1.25
                    else
                      assign submit_pad = 1
                  endcase
                  case b.input_size
                    when 'small'
                      assign input_pad = 0.8
                    when 'large'
                      assign input_pad = 1.25
                    else
                      assign input_pad = 1
                  endcase
                  assign submit_case = 'none'
                  if b.button_uppercase
                    assign submit_case = 'uppercase'
                  endif
                  assign email_id = 'DropSignupEmail-' | append: block.id
                  assign error_id = 'DropSignupError-' | append: block.id
                %}
                <div
                  class="drop-signup__block drop-signup__email"
                  style="--b-space: {{ b_space }}; --b-scale: {{ b_scale }}; --b-submit-pad: {{ submit_pad }}; --b-input-pad: {{ input_pad }}; --b-submit-case: {{ submit_case }}; --b-submit-radius: {{ b.button_radius }}px; --b-input-radius: {{ b.input_radius }}px;"
                  {{ block.shopify_attributes }}
                >
                  <input type="hidden" name="contact[tags]" value="{{ s.customer_tag | escape }}">
                  <div class="drop-signup__email-row">
                    <label for="{{ email_id }}" class="visually-hidden">{{ 'blocks.email_signup.label' | t }}</label>
                    <input
                      id="{{ email_id }}"
                      class="drop-signup__input"
                      type="email"
                      name="contact[email]"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      placeholder="{{ b.placeholder | escape }}"
                      required
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="{{ error_id }}"
                      {% endif %}
                    >
                    <button type="submit" class="drop-signup__submit drop-signup__submit--{{ b.button_style }}">{{ b.button_label | escape }}</button>
                  </div>
                  {% if form.errors %}
                    <p id="{{ error_id }}" class="drop-signup__error" role="alert">
                      {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                    </p>
                  {% endif %}
                </div>
              {% endunless %}

            {% when 'confirmation' %}
              {% if posted and b.text != blank %}
                {% liquid
                  assign c_case = 'none'
                  if b.uppercase
                    assign c_case = 'uppercase'
                  endif
                %}
                <p
                  class="drop-signup__block drop-signup__confirm"
                  style="--b-space: {{ b_space }}; --b-scale: {{ b_scale }}; --b-case: {{ c_case }};"
                  tabindex="-1"
                  data-drop-signup-confirm
                  {{ block.shopify_attributes }}
                >{{ b.text | escape }}</p>
              {% endif %}

            {% when 'divider' %}
              {% if show_discord %}
                <hr
                  class="drop-signup__block drop-signup__divider"
                  style="--b-space: {{ b_space }};"
                  {{ block.shopify_attributes }}
                >
              {% endif %}

            {% when 'discord' %}
              {% if show_discord %}
                {% liquid
                  case b.button_size
                    when 'small'
                      assign discord_pad = 0.8
                    when 'large'
                      assign discord_pad = 1.25
                    else
                      assign discord_pad = 1
                  endcase
                  assign d_case = 'none'
                  if b.uppercase
                    assign d_case = 'uppercase'
                  endif
                  assign small_scale = b.small_text_size | divided_by: 100.0
                %}
                <div
                  class="drop-signup__block drop-signup__discord-block drop-signup__discord-block--{{ b.button_width }}"
                  style="--b-space: {{ b_space }}; --b-scale: {{ b_scale }}; --b-small-scale: {{ small_scale }}; --b-discord-pad: {{ discord_pad }}; --b-case: {{ d_case }}; --b-radius: {{ b.button_radius }}px; --b-bg: {{ b.color }}; --b-text: {{ b.text_color }};"
                  {{ block.shopify_attributes }}
                >
                  {% if b.lead != blank %}
                    <p class="drop-signup__discord-lead">{{ b.lead | escape }}</p>
                  {% endif %}
                  {% if b.url != blank %}
                    <a
                      class="drop-signup__discord"
                      href="{{ b.url }}"
                      {% if b.new_tab %}target="_blank" rel="noopener"{% endif %}
                      data-drop-signup-discord
                    >
                      {% if b.show_icon %}
                        <span class="drop-signup__discord-icon" aria-hidden="true">{{ 'icon-ci-discord.svg' | inline_asset_content }}</span>
                      {% endif %}
                      {{ b.label | escape }}
                    </a>
                    {% if b.reassurance != blank %}
                      <p class="drop-signup__reassurance">{{ b.reassurance | escape }}</p>
                    {% endif %}
                  {% elsif request.design_mode %}
                    <p class="drop-signup__error">Add the Discord invite URL in this block's settings.</p>
                  {% endif %}
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
      {% endform %}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('DropSignup-{{ section.id }}');
    if (!root || !window.Shopify || !Shopify.analytics || !Shopify.analytics.publish) return;
    var payload = {
      section_id: '{{ section.id }}',
      mode: '{{ s.mode }}',
      customer_tag: {{ s.customer_tag | json }},
      page_path: window.location.pathname
    };
    var confirm = root.querySelector('[data-drop-signup-confirm]');
    if (confirm) {
      Shopify.analytics.publish('drop_signup_email_captured', payload);
      confirm.focus({ preventScroll: true });
    }
    var discord = root.querySelector('[data-drop-signup-discord]');
    if (discord) {
      discord.addEventListener('click', function () {
        Shopify.analytics.publish('drop_signup_discord_click', Object.assign({ discord_url: discord.href }, payload));
      });
    }
  })();
</script>

{% stylesheet %}
  .drop-signup {
    --ds-s: var(--ds-scale, 1);
    min-height: calc(100svh - var(--ds-chrome-offset, 0px));
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .drop-signup__hero {
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 2000px;
    margin-inline: auto;
    aspect-ratio: var(--ds-ratio);
    overflow: hidden;
  }
  .drop-signup__hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--ds-overlay, 0));
    pointer-events: none;
    z-index: 1;
  }
  .drop-signup__picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .drop-signup__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .drop-signup__panel {
    position: absolute;
    top: 7%;
    bottom: 6%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: var(--ds-panel-valign, center);
    text-align: center;
  }
  .drop-signup--align-left .drop-signup__panel {
    text-align: left;
  }
  .drop-signup--panel-right .drop-signup__panel {
    left: var(--ds-panel-offset);
    right: 4%;
  }
  .drop-signup--panel-left .drop-signup__panel {
    right: var(--ds-panel-offset);
    left: 4%;
  }
  .drop-signup__form {
    display: block;
    width: 100%;
  }
  .drop-signup__block {
    margin: 0;
  }

  /* Headline */
  .drop-signup__headline {
    margin-block-start: calc(2cqi * var(--b-space, 0));
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: calc(4.4cqi * var(--ds-s) * var(--b-scale, 1));
    line-height: var(--b-leading, 1.02);
    letter-spacing: var(--b-tracking, -0.02em);
    text-transform: var(--b-case, uppercase);
    color: var(--color-foreground-heading);
  }

  /* Supporting copy */
  .drop-signup__lede {
    margin-block-start: calc(1.4cqi * var(--b-space, 1));
    margin-inline: auto;
    max-width: var(--b-max, 34ch);
    font-size: calc(1.32cqi * var(--ds-s) * var(--b-scale, 1));
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }
  .drop-signup--align-left .drop-signup__lede {
    margin-inline: 0;
  }

  /* Email form */
  .drop-signup__email {
    margin-block-start: calc(3.4cqi * var(--b-space, 1));
  }
  .drop-signup__email-row {
    display: flex;
    gap: 0.7cqi;
  }
  .drop-signup__input,
  .drop-signup__submit {
    font-family: inherit;
    font-size: calc(1.25cqi * var(--ds-s) * var(--b-scale, 1));
    color: var(--color-foreground);
    background: transparent;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.32);
  }
  .drop-signup__input {
    flex: 1;
    min-width: 0;
    padding: calc(1.05cqi * var(--b-input-pad, 1)) 1.2cqi;
    border-radius: var(--b-input-radius, 4px);
  }
  .drop-signup__input::placeholder {
    color: rgb(var(--color-foreground-rgb) / 0.4);
  }
  .drop-signup__input[aria-invalid='true'] {
    border-color: rgb(var(--color-foreground-rgb) / 0.7);
  }
  .drop-signup__submit {
    padding: calc(1.05cqi * var(--b-submit-pad, 1)) calc(1.7cqi * var(--b-submit-pad, 1));
    font-weight: 500;
    text-transform: var(--b-submit-case, none);
    border-radius: var(--b-submit-radius, 4px);
    cursor: pointer;
    white-space: nowrap;
    transition: background 140ms ease, opacity 140ms ease;
  }
  .drop-signup__submit--outline:hover {
    background: rgb(var(--color-foreground-rgb) / 0.1);
  }
  .drop-signup__submit--solid {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
    font-weight: 700;
  }
  .drop-signup__submit--solid:hover {
    opacity: 0.88;
  }
  .drop-signup__error {
    margin: 1cqi 0 0;
    font-size: calc(1.05cqi * var(--ds-s));
    color: #ff9c9c;
  }

  /* Confirmation */
  .drop-signup__confirm {
    margin-block-start: calc(3.4cqi * var(--b-space, 1));
    font-size: calc(1.7cqi * var(--ds-s) * var(--b-scale, 1));
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: var(--b-case, uppercase);
    color: var(--color-foreground-heading);
    outline: none;
  }

  /* Divider */
  .drop-signup__divider {
    margin-block-start: calc(3.2cqi * var(--b-space, 1));
    border: 0;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
  }

  /* Discord */
  .drop-signup__discord-block {
    margin-block-start: calc(2.1cqi * var(--b-space, 1));
  }
  .drop-signup__discord-lead {
    margin: 0 0 1.3cqi;
    font-size: calc(1.22cqi * var(--ds-s) * var(--b-small-scale, 1));
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }
  .drop-signup__discord {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: calc(1.45cqi * var(--b-discord-pad, 1)) calc(1.5rem * var(--b-discord-pad, 1));
    background: var(--b-bg, #5865f2);
    color: var(--b-text, #fff);
    font-size: calc(1.42cqi * var(--ds-s) * var(--b-scale, 1));
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: var(--b-case, uppercase);
    text-decoration: none;
    border-radius: var(--b-radius, 4px);
    transition: filter 140ms ease;
  }
  .drop-signup__discord-block--fit .drop-signup__discord {
    display: inline-flex;
  }
  .drop-signup__discord:hover {
    filter: brightness(0.92);
  }
  .drop-signup__discord:focus-visible {
    outline: 3px solid var(--color-foreground);
    outline-offset: 3px;
  }
  .drop-signup__discord-icon {
    display: inline-flex;
    width: calc(1.9cqi * var(--ds-s) * var(--b-scale, 1));
    height: calc(1.9cqi * var(--ds-s) * var(--b-scale, 1));
    flex: none;
  }
  .drop-signup__discord-icon svg {
    width: 100%;
    height: 100%;
  }
  .drop-signup__discord-icon svg path {
    fill: currentColor;
  }
  .drop-signup__reassurance {
    margin: 1cqi 0 0;
    font-size: calc(1.08cqi * var(--ds-s) * var(--b-small-scale, 1));
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  @media screen and (min-width: 1024px) {
    .drop-signup--fade .drop-signup__img {
      -webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 82%, transparent 100%);
    }
  }

  @media screen and (max-width: 1023px) {
    .drop-signup {
      --ds-s: calc(var(--ds-scale, 1) * var(--ds-mobile-scale, 1));
    }
    .drop-signup__hero {
      container-type: normal;
      display: flex;
      flex-direction: column;
      min-height: 100svh;
      aspect-ratio: auto;
      padding-block-end: 3rem;
      overflow: visible;
    }
    .drop-signup__picture {
      height: auto;
    }
    .drop-signup__img {
      height: var(--ds-mobile-img-height, 62svh);
      aspect-ratio: auto;
      object-position: var(--ds-mobile-focus, 30%) center;
      -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
    }
    .drop-signup__panel,
    .drop-signup--panel-right .drop-signup__panel,
    .drop-signup--panel-left .drop-signup__panel {
      position: relative;
      inset: auto;
      width: 100%;
      max-width: 34rem;
      margin: -12svh auto 0;
      padding: 0 calc(2rem * var(--ds-mobile-pad, 1));
    }
    .drop-signup__headline {
      margin-block-start: calc(1.1rem * var(--b-space, 0));
      font-size: calc(2.6rem * var(--ds-s) * var(--b-scale, 1));
    }
    .drop-signup__lede {
      margin-block-start: calc(1.1rem * var(--b-space, 1));
      font-size: calc(1rem * var(--ds-s) * var(--b-scale, 1));
      max-width: calc(var(--b-max, 34ch) + 6ch);
    }
    .drop-signup__email {
      margin-block-start: calc(2rem * var(--b-space, 1));
    }
    .drop-signup__email-row {
      gap: 0.5rem;
    }
    .drop-signup__input,
    .drop-signup__submit {
      font-size: calc(0.9375rem * var(--ds-s) * var(--b-scale, 1));
    }
    .drop-signup__input {
      padding: calc(0.8rem * var(--b-input-pad, 1)) 0.9rem;
    }
    .drop-signup__submit {
      padding: calc(0.8rem * var(--b-submit-pad, 1)) calc(1.25rem * var(--b-submit-pad, 1));
    }
    .drop-signup__error {
      margin-block-start: 0.6rem;
      font-size: calc(0.8125rem * var(--ds-s));
    }
    .drop-signup__confirm {
      margin-block-start: calc(2rem * var(--b-space, 1));
      font-size: calc(1.25rem * var(--ds-s) * var(--b-scale, 1));
    }
    .drop-signup__divider {
      margin-block-start: calc(2.25rem * var(--b-space, 1));
    }
    .drop-signup__discord-block {
      margin-block-start: calc(1.5rem * var(--b-space, 1));
    }
    .drop-signup__discord-lead {
      margin-block-end: 0.85rem;
      font-size: calc(0.9375rem * var(--ds-s) * var(--b-small-scale, 1));
    }
    .drop-signup__discord {
      padding: calc(1.1rem * var(--b-discord-pad, 1)) calc(1.5rem * var(--b-discord-pad, 1));
      font-size: calc(1.0625rem * var(--ds-s) * var(--b-scale, 1));
    }
    .drop-signup__discord-icon {
      width: calc(22px * var(--ds-s) * var(--b-scale, 1));
      height: calc(22px * var(--ds-s) * var(--b-scale, 1));
    }
    .drop-signup__reassurance {
      margin-block-start: 0.7rem;
      font-size: calc(0.8125rem * var(--ds-s) * var(--b-small-scale, 1));
    }
  }

  @media screen and (max-width: 599px) {
    .drop-signup__hero {
      padding-block-end: 2.25rem;
    }
    .drop-signup__panel,
    .drop-signup--panel-right .drop-signup__panel,
    .drop-signup--panel-left .drop-signup__panel {
      margin-block-start: -10svh;
      padding: 0 calc(1.25rem * var(--ds-mobile-pad, 1));
    }
    .drop-signup__headline {
      margin-block-start: calc(0.85rem * var(--b-space, 0));
      font-size: calc(2rem * var(--ds-s) * var(--b-scale, 1));
    }
    .drop-signup__lede {
      margin-block-start: calc(0.85rem * var(--b-space, 1));
      font-size: calc(0.9375rem * var(--ds-s) * var(--b-scale, 1));
    }
    .drop-signup__email {
      margin-block-start: calc(1.5rem * var(--b-space, 1));
    }
    .drop-signup__email-row {
      flex-direction: column;
    }
    .drop-signup__submit {
      width: 100%;
    }
    .drop-signup__confirm {
      margin-block-start: calc(1.5rem * var(--b-space, 1));
    }
    .drop-signup__divider {
      margin-block-start: calc(1.85rem * var(--b-space, 1));
    }
    .drop-signup__discord-block {
      margin-block-start: calc(1.25rem * var(--b-space, 1));
    }
    .drop-signup__discord {
      padding: calc(1rem * var(--b-discord-pad, 1)) calc(1.25rem * var(--b-discord-pad, 1));
      font-size: calc(1rem * var(--ds-s) * var(--b-scale, 1));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drop-signup__submit,
    .drop-signup__discord {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Drop signup",
  "tag": "section",
  "class": "section-drop-signup",
  "settings": [
    {
      "type": "paragraph",
      "content": "Two-step ad landing page. Each element in the panel is a block: click it in the preview to edit its copy, size and spacing. Size and spacing sliders are relative, 100% is the default look."
    },
    {
      "type": "header",
