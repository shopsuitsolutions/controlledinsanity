{% liquid
  assign total = section.blocks.size
  assign initial = section.settings.initial_count
  if initial > total
    assign initial = total
  endif
%}
<div
  class="ci-athletes section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %} --ci-athletes-batch: {{ section.settings.load_count }};"
  data-initial="{{ initial }}"
  data-batch="{{ section.settings.load_count }}"
  {{ section.shopify_attributes }}
>
  {% if section.settings.heading != blank %}
    <h2 class="ci-athletes__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="ci-athletes__grid">
    {% for block in section.blocks %}
      <article
        class="ci-athletes__card"
        data-athlete-card
        {% if forloop.index0 >= initial %}hidden{% endif %}
        {{ block.shopify_attributes }}
      >
        {%- liquid
          assign profile_link = block.settings.profile_link
          assign profile_external = false
          if profile_link != blank and profile_link contains 'http'
            assign profile_external = true
          endif
        -%}
        <div class="ci-athletes__media">
          {% if profile_link != blank %}
            <a class="ci-athletes__media-link" href="{{ profile_link }}" aria-label="{{ block.settings.name | escape }}"{% if profile_external %} target="_blank" rel="noopener"{% endif %}>
          {% endif %}
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 680 | image_tag: class: 'ci-athletes__img', loading: 'lazy', widths: '339, 480, 680', sizes: '(max-width: 749px) 45vw, 25vw', alt: block.settings.name }}
          {% endif %}
          {% if block.settings.handle != blank and block.settings.show_handle %}
            <span class="ci-athletes__handle">{{ block.settings.handle }}</span>
          {% endif %}
          {% if profile_link != blank %}
            </a>
          {% endif %}
        </div>
        <div class="ci-athletes__body">
          {% if block.settings.name != blank %}
            <p class="ci-athletes__name">
              {% if profile_link != blank %}
                <a class="ci-athletes__name-link" href="{{ profile_link }}"{% if profile_external %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.name }}</a>
              {% else %}
                {{ block.settings.name }}
              {% endif %}
            </p>
          {% endif %}
          {% if block.settings.subtitle != blank %}
            <p class="ci-athletes__sub">{{ block.settings.subtitle }}</p>
          {% endif %}
          {% if block.settings.bio != blank %}
            <p class="ci-athletes__bio">{{ block.settings.bio }}</p>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>

  {% if total > initial %}
    <div class="ci-athletes__more">
      <p class="ci-athletes__count"><span data-athlete-shown>{{ initial }}</span> out of {{ total }}</p>
      <button type="button" class="button ci-athletes__load" data-athlete-load>{{ section.settings.load_more_label | default: 'Load more' }}</button>
    </div>
  {% endif %}
</div>

<script src="{{ 'ci-athletes.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  .ci-athletes__heading {
    text-align: center;
    margin-block: 0 var(--gap-xl, 40px);
  }
  .ci-athletes__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 4px;
    row-gap: 40px;
  }
  .ci-athletes__card[hidden] {
    display: none;
  }
  .ci-athletes__media {
    position: relative;
    aspect-ratio: 339 / 478;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / 0.06);
  }
  .ci-athletes__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ci-athletes__media-link {
    display: block;
    height: 100%;
  }
  .ci-athletes__name-link {
    color: inherit;
    text-decoration: none;
  }
  .ci-athletes__name-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ci-athletes__handle {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--ci-black, #000);
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    line-height: 1;
    padding: 7px 10px;
  }
  .ci-athletes__body {
    padding-block-start: 12px;
  }
  .ci-athletes__name {
    margin: 0;
    font-weight: var(--font-subheading--weight, 600);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .ci-athletes__sub {
    margin: 2px 0 8px;
    font-size: 0.875rem;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }
  .ci-athletes__bio {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }
  .ci-athletes__more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-block-start: 48px;
  }
  .ci-athletes__count {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }
  @media screen and (max-width: 749px) {
    .ci-athletes__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 4px;
      row-gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CI Athletes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "range", "id": "initial_count", "label": "Cards shown before Load more", "min": 4, "max": 40, "step": 1, "default": 8 },
    { "type": "range", "id": "load_count", "label": "Cards revealed per Load more", "min": 2, "max": 20, "step": 1, "default": 8 },
    { "type": "text", "id": "load_more_label", "label": "Load more label", "default": "Load more" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "section_width", "label": "Width", "options": [ { "value": "page-width", "label": "Page" }, { "value": "full-width", "label": "Full" } ], "default": "page-width" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "athlete",
      "name": "Athlete",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle (e.g. @kevstrength)" },
        { "type": "checkbox", "id": "show_handle", "label": "Show handle overlay on image", "info": "Turn on if your photo does not already include the handle.", "default": false },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "url", "id": "profile_link", "label": "Profile link", "info": "Optional. Image and name link here; external links open in a new tab." },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "IFBB Pro" },
        { "type": "textarea", "id": "bio", "label": "Bio" }
      ]
    }
  ],
  "presets": [ { "name": "CI Athletes", "blocks": [] } ]
}
{% endschema %}
